{
  "name": "cloudhop",
  "version": "1.2.1",
  "description": "Every cloud account, one short alias away. Sign in to AWS SSO portals and personal accounts once, hop between accounts, roles and regions with one command. No access keys.",
  "keywords": [
    "cli",
    "aws",
    "aws-cli",
    "aws-sso",
    "sso",
    "iam-identity-center",
    "aws-login",
    "multi-account",
    "profiles",
    "credentials",
    "terraform",
    "cloud",
    "devops"
  ],
  "license": "Apache-2.0",
  "author": "dayepesb",
  "homepage": "https://dayepesb.github.io/cloudhop/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dayepesb/cloudhop.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/dayepesb/cloudhop/issues"
  },
  "type": "module",
  "bin": {
    "cloudhop": "dist/cli.js",
    "hop": "dist/cli.js"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepack": "cp ../../README.md ../../LICENSE ../../NOTICE . && tsup"
  },
  "devDependencies": {
    "@clack/prompts": "^1.8.1",
    "@cloudhop/adapters-node": "workspace:*",
    "@cloudhop/assistants": "workspace:*",
    "@cloudhop/core": "workspace:*",
    "@cloudhop/mcp": "workspace:*",
    "@cloudhop/provider-aws": "workspace:*",
    "@cloudhop/ui": "workspace:*",
    "yaml": "^2.9.1"
  }
}
