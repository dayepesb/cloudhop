{
  "name": "cloudhop",
  "version": "0.1.1",
  "description": "Hop between cloud accounts, roles and regions with one command. Automatic login, no copied credentials.",
  "keywords": [
    "cli",
    "aws",
    "sso",
    "iam-identity-center",
    "aws-login",
    "multi-account",
    "profiles",
    "credentials",
    "cloud"
  ],
  "license": "Apache-2.0",
  "author": "dayepesb",
  "homepage": "https://github.com/dayepesb/cloudhop#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dayepesb/cloudhop.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/dayepesb/cloudhop/issues"
  },
  "type": "module",
  "bin": {
    "cloudhop": "dist/cli.js",
    "hop": "dist/cli.js"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepack": "cp ../../README.md ../../LICENSE ../../NOTICE . && tsup"
  },
  "devDependencies": {
    "@clack/prompts": "^1.8.1",
    "@cloudhop/adapters-node": "workspace:*",
    "@cloudhop/core": "workspace:*",
    "@cloudhop/provider-aws": "workspace:*",
    "@cloudhop/ui": "workspace:*"
  }
}
